# Copy to .env.local for local development. On Vercel, set these as the project's environment variables.

# OAuth client id of a Google "Web application" client.
GOOGLE_CLIENT_ID=

# That client's secret.
GOOGLE_CLIENT_SECRET=

# Comma-separated Google accounts allowed to sign in.
ALLOWED_EMAILS=

# Fixes the public origin. Leave it out on Vercel to use the request's host.
PUBLIC_URL=http://localhost:3000

# Key material for sealing codes and tokens. Defaults to GOOGLE_CLIENT_SECRET. Changing it signs every client out.
# TOKEN_SECRET=

# Point the server at a stand-in Google for local end-to-end testing. Never set these in production.
# GOOGLE_AUTH_URL=
# GOOGLE_TOKEN_URL=
# GOOGLE_REVOKE_URL=
# GOOGLE_TASKS_API_URL=
